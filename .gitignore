# ==========================================
# CampusBridge - Root Git Ignore
# ==========================================

# ---------- Environment variables and secrets ----------
.env
.env.*
!.env.example
!.env.sample
**/application-local.properties
**/application-local.yml
**/application-local.yaml
*.pem
*.key

# ---------- Node.js / React frontend ----------
node_modules/
**/node_modules/
frontend/build/
frontend/dist/
**/.npm/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ---------- Java / Spring Boot / Maven backend ----------
target/
**/target/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# ---------- IDE and editor files ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml
*.suo
*.user
*.code-workspace

# ---------- Operating system files ----------
.DS_Store
Thumbs.db
Desktop.ini

# ---------- Logs and temporary files ----------
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo

# ---------- Python, if used for scripts ----------
__pycache__/
*.py[cod]
.venv/
venv/
env/

# ---------- Generated test and coverage reports ----------
coverage/
.nyc_output/
test-results/
playwright-report/

# ---------- Uploads and user-generated data ----------
# Keep uploaded private files out of Git.
# Uncomment the following line if uploads contain user data:
# backend/uploads/

# ---------- Local databases and backups ----------
*.sqlite
*.sqlite3
*.db
*.sql.bak
*.dump
database/backups/

# ---------- Generated frontend output ----------
# Keep source code and package-lock.json tracked.
# Do not ignore package.json or package-lock.json.